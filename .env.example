# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Public anon key (safe to expose in browser)
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (KEEP SECRET - only for development!)
# ⚠️  This key bypasses RLS - ONLY use in development
# ⚠️  In production, this should NOT be set (API endpoints will be used instead)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key (for AI Examen)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# AI Gateway API Key (for Look-alike Examen with Grok)
# Get your API key from: https://console.x.ai/
# Optional - enables "Look-alike Examen" feature with Grok 4 Fast
AI_GATEWAY_API_KEY=your-grok-api-key-here

# Mollie Payment Integration
# Get your API keys from: https://my.mollie.com/dashboard/developers/api-keys
# ⚠️  CRITICAL: Use test_ key for development, live_ key for production
MOLLIE_API_KEY=test_xxxxx
# For production, change to: MOLLIE_API_KEY=live_xxxxx

# Subscription Settings
VITE_SUBSCRIPTION_PRICE=12.50
VITE_TRIAL_DAYS=7

# Development fallback (set to 'false' in production)
VITE_ALLOW_DEV_FALLBACK=false

# ============================================================================
# ADMIN AUTHENTICATION - CRITICAL SECURITY SETTINGS (SERVER-SIDE ONLY!)
# ============================================================================
# 🔒 BELANGRIJK: Deze variabelen hebben GEEN "VITE_" prefix, wat betekent
# dat ze ALLEEN beschikbaar zijn op de server (in /api endpoints).
# Het admin wachtwoord wordt NOOIT naar de browser gestuurd!
#
# Voor Local Development:
# - Zet deze in je .env of .env.local bestand
# - De /api/admin-login endpoint gebruikt deze credentials
#
# Voor Productie (Vercel/Netlify/etc):
# - Stel deze in via je hosting platform dashboard
# - Bijvoorbeeld Vercel: Project Settings → Environment Variables
# - Zorg dat je de VITE_ prefix NIET gebruikt voor deze variabelen!
#
# Admin wachtwoord eisen:
# - Minimaal 16 karakters (systeem vereist min. 12)
# - Gebruik hoofdletters, kleine letters, cijfers en speciale tekens
# - NOOIT veelvoorkomende wachtwoorden zoals 'admin123', 'password', etc.
# - Gebruik een wachtwoordmanager (1Password, Bitwarden, LastPass)
#
# Genereer een sterk wachtwoord met:
#   openssl rand -base64 24
#   pwgen -s 24 1
#
ADMIN_PASSWORD=your-super-strong-admin-password-here
ADMIN_USERNAME=admin

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
# ⚠️  Required for sending transactional emails (welcome, trial reminders, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Cron Job Security
# Generate a random secret token for cron job authentication
# Use: openssl rand -base64 32
CRON_SECRET=your-random-secret-token-here

# Application URL (for email links and redirects)
VITE_APP_URL=http://localhost:5173
# For production: VITE_APP_URL=https://examentrainer.nl

# Supabase Service Role Key (for API endpoints)
# ⚠️  Required in production for API endpoints to work
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
