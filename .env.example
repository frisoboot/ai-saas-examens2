# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Public anon key (safe to expose in browser)
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (KEEP SECRET - only for development!)
# ⚠️  This key bypasses RLS - ONLY use in development
# ⚠️  In production, this should NOT be set (API endpoints will be used instead)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Mollie Payment Integration
# Get your API keys from: https://my.mollie.com/dashboard/developers/api-keys
# ⚠️  CRITICAL: Use test_ key for development, live_ key for production
MOLLIE_API_KEY=test_xxxxx
# For production, change to: MOLLIE_API_KEY=live_xxxxx

# Subscription Settings
VITE_SUBSCRIPTION_PRICE=12.50
VITE_TRIAL_DAYS=7

# Development fallback (set to 'false' in production)
VITE_ALLOW_DEV_FALLBACK=false
