# ============================================================================
# ENVIRONMENT VARIABLES - SECURITY GUIDE
# ============================================================================
#
# VITE_ prefix = EXPOSED to browser (public, visible to users)
# No prefix = SERVER-SIDE ONLY (secret, never sent to browser)
#
# ============================================================================

# ============================================================================
# PUBLIC KEYS (Browser-safe - protected by Supabase RLS)
# ============================================================================

# Supabase Configuration - Get from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# SECRET KEYS (Server-side only - NEVER add VITE_ prefix!)
# ============================================================================

# Google Gemini API Key (for AI features)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini Model Override (defaults to gemini-3-flash-preview)
# Available models: gemini-3-flash-preview (recommended), gemini-2.5-flash, gemini-2.5-pro
# GEMINI_MODEL=gemini-3-flash-preview

# Supabase Service Role Key (for API endpoints)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# MOLLIE PAYMENT INTEGRATION (SERVER-SIDE ONLY!)
# ============================================================================
# Get your API key from: https://my.mollie.com/dashboard/developers/api-keys
# Use TEST key for development, LIVE key for production
#
# Test mode: test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Live mode: live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: App URL for redirects (auto-detected on Vercel)
# VITE_APP_URL=https://ai-examentrainer.nl

# ============================================================================
# ADMIN AUTHENTICATION - EMAIL BASED
# ============================================================================
# Admin accounts worden bepaald op basis van email adres.
# Voeg admin email adressen toe aan VITE_ADMIN_EMAILS (komma-gescheiden).
#
# Stappen om een admin toe te voegen:
# 1. Ga naar: https://app.supabase.com/project/_/auth/users
# 2. Klik "Add user" → "Create new user"
# 3. Email: je echte email adres (bijv. admin@jouwdomein.nl)
# 4. Wachtwoord: minimaal 12 karakters (16+ aanbevolen)
# 5. Auto confirm: Aan
# 6. Voeg het email adres toe aan VITE_ADMIN_EMAILS hieronder
#
# Studenten en admins loggen in met hun echte email adres.
# De rol wordt bepaald door te checken of het email in VITE_ADMIN_EMAILS staat.
#
# Genereer een sterk wachtwoord met:
#   openssl rand -base64 24
# ============================================================================

# Admin email adressen (komma-gescheiden, geen spaties)
# Voorbeeld: admin@jouwdomein.nl,backup-admin@jouwdomein.nl
VITE_ADMIN_EMAILS=admin@jouwdomein.nl

# ============================================================================
# EMAIL SERVICE (Resend)
# ============================================================================
# Resend is een email delivery service voor transactionele emails.
# Maak een gratis account aan op: https://resend.com
#
# Stappen:
# 1. Ga naar https://resend.com en maak een account
# 2. Verifieer je domein (ai-examentrainer.nl)
# 3. Genereer een API key in het dashboard
# 4. Voeg de API key hieronder toe
#
# BELANGRIJK: Zonder deze key worden er GEEN emails verstuurd!
# ============================================================================

# Resend API key (verplicht voor email functionaliteit)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Van-adres voor emails (moet geverifieerd domein zijn)
EMAIL_FROM=AI Examentrainer <noreply@ai-examentrainer.nl>

# Email adres voor admin notificaties (nieuwe aanmeldingen, etc.)
ADMIN_NOTIFICATION_EMAIL=info@ai-examentrainer.nl

# ============================================================================
# CRON JOBS (optioneel)
# ============================================================================
# Secret voor het beveiligen van cron job endpoints.
# Genereer met: openssl rand -base64 32
# Als niet ingesteld, zijn cron endpoints publiek toegankelijk.
# ============================================================================

# CRON_SECRET=your-random-secret-here
